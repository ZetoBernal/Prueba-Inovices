      "name": "01 Autenticación",
      "description": "Login con JWT, validación de entrada y protección de rutas.",
      "item": [
        {
          "name": "CP-A01 Login OPERADOR válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se ejecuta solo en la primera iteración: las demás iteraciones del CSV",
                  "// recorren únicamente los casos de creación de facturas.",
                  "if (pm.info.iteration > 0) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Login exitoso: debe devolver un JWT y el rol del usuario.",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('CP-A01 Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CP-A01 Devuelve un token con formato JWT (3 segmentos)', () => {",
                  "    pm.expect(cuerpo.token).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
                  "});",
                  "pm.test('CP-A01 El rol es OPERADOR', () => pm.expect(cuerpo.role).to.eql('OPERADOR'));",
                  "pm.test('CP-A01 La fecha de expiración es futura', () => {",
                  "    pm.expect(new Date(cuerpo.expiresAt).getTime()).to.be.above(Date.now());",
                  "});",
                  "",
                  "// Se guarda el token para las peticiones siguientes (autorización heredada).",
                  "pm.collectionVariables.set('tokenOperador', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
