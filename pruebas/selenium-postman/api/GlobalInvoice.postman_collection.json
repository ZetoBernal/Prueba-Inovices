  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Al iniciar la corrida se limpian los valores de una ejecución anterior.",
          "if (pm.info.iteration === 0 && pm.info.requestName.startsWith('CP-A01')) {",
          "    ['tokenOperador', 'tokenAuditor', 'idFacturaCreada', 'numeroFacturaCreada', 'intentosLogin']",
          "        .forEach(v => pm.collectionVariables.unset(v));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verificaciones comunes a todas las peticiones.",
          "pm.test('[General] Responde en menos de 6 segundos', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(6000);",
          "});",
          "if (pm.response.text().length > 0) {",
          "    pm.test('[General] El cuerpo es JSON', () => {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.match(/json/);",
          "    });",
          "}"
        ]
      }
    }
  ],
