    {
      "name": "03 Creación y reglas de negocio",
      "description": "Motor de impuestos por tipo de factura (guiado por CSV) y control de acceso por rol.",
      "item": [
        {
          "name": "CP-A12..A19 Crear factura (casos del CSV)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Arma el cuerpo de la petición a partir de la fila actual del CSV",
                  "// (api/datos/casos-facturas.csv). Si se ejecuta sin archivo de datos,",
                  "// usa un caso por defecto para que la petición siga siendo útil.",
                  "const fila = pm.iterationData.toObject();",
                  "const caso = fila.caso ? fila : {",
                  "    caso: 'CP-A12', descripcion: 'Factura nacional (caso por defecto)', cliente: 'Postman Nacional',",
                  "    tipo: 1, subtotal: 1000000, estadoEsperado: 201, ivaEsperado: 190000, retencionEsperada: 0, totalEsperado: 1190000",
                  "};",
                  "",
                  "const cuerpo = {",
                  "    customerName: caso.cliente || '',",
                  "    type: Number(caso.tipo),",
                  "    subtotal: Number(caso.subtotal)",
                  "};",
                  "if (caso.codigoAduanero) cuerpo.customsCode = caso.codigoAduanero;",
                  "",
                  "pm.variables.set('casoActual', JSON.stringify(caso));",
                  "pm.variables.set('cuerpoFactura', JSON.stringify(cuerpo, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caso = JSON.parse(pm.variables.get('casoActual'));",
                  "const id = `${caso.caso} ${caso.descripcion}`;",
                  "const esperado = Number(caso.estadoEsperado);",
                  "",
                  "pm.test(`${id} -> código ${esperado}`, () => pm.response.to.have.status(esperado));",
                  "",
                  "if (esperado === 201) {",
                  "    const factura = pm.response.json();",
                  "",
                  "    pm.test(`${caso.caso} Número consecutivo con formato FAC-00000`, () => {",
                  "        pm.expect(factura.number).to.match(/^FAC-\\d{5}$/);",
                  "    });",
                  "    pm.test(`${caso.caso} IVA = ${caso.ivaEsperado}`, () => pm.expect(factura.iva).to.eql(Number(caso.ivaEsperado)));",
                  "    pm.test(`${caso.caso} Retención = ${caso.retencionEsperada}`, () => pm.expect(factura.retencion).to.eql(Number(caso.retencionEsperada)));",
                  "    pm.test(`${caso.caso} Total = ${caso.totalEsperado}`, () => pm.expect(factura.total).to.eql(Number(caso.totalEsperado)));",
                  "    pm.test(`${caso.caso} Código aduanero solo en exportación`, () => {",
                  "        if (Number(caso.tipo) === 2) pm.expect(factura.customsCode).to.eql(caso.codigoAduanero);",
                  "        else pm.expect(factura.customsCode).to.be.null;",
                  "    });",
                  "    pm.test(`${caso.caso} Header Location apunta al recurso creado`, () => {",
                  "        pm.expect(pm.response.headers.get('Location')).to.match(new RegExp(`/api/invoices/${factura.id}$`, 'i'));",
                  "    });",
                  "",
                  "    // La primera factura creada se usa luego en CP-A20.",
                  "    if (!pm.collectionVariables.get('idFacturaCreada')) {",
                  "        pm.collectionVariables.set('idFacturaCreada', factura.id);",
                  "        pm.collectionVariables.set('numeroFacturaCreada', factura.number);",
                  "    }",
                  "} else {",
                  "    pm.test(`${caso.caso} El error se reporta en el campo ${caso.campoError}`, () => {",
                  "        const campos = Object.keys(pm.response.json().errors).map(c => c.toLowerCase());",
                  "        pm.expect(campos).to.include(caso.campoError.toLowerCase());",
                  "    });",
                  "}"
                ]
              }
            }
          ],
