    {
      "name": "04 Seguridad",
      "description": "Rate limiting del login.",
      "item": [
        {
          "name": "CP-A23 Límite de intentos de login (rate limiting)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se ejecuta solo en la última iteración, cuando ya se probaron todos los casos.",
                  "if (pm.info.iteration < pm.info.iterationCount - 1) { pm.execution.skipRequest(); }",
                  "const intentos = Number(pm.collectionVariables.get('intentosLogin') || 0) + 1;",
                  "pm.collectionVariables.set('intentosLogin', intentos);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El backend permite 5 intentos de login por minuto por IP (Program.cs).",
                  "// Esta petición se repite hasta recibir 429 o agotar 6 intentos.",
                  "const intentos = Number(pm.collectionVariables.get('intentosLogin'));",
                  "const MAX_INTENTOS = 6;",
                  "",
                  "pm.test(`CP-A23 Intento ${intentos}: responde 401 o 429`, () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 429]);",
                  "});",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test('CP-A23 Bloquea los intentos excesivos con 429 Too Many Requests', () => {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "    pm.collectionVariables.unset('intentosLogin');",
                  "} else if (intentos < MAX_INTENTOS) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.test('CP-A23 Bloquea los intentos excesivos con 429 Too Many Requests', () => {",
                  "        pm.expect.fail(`Tras ${MAX_INTENTOS} intentos no se recibió 429`);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
