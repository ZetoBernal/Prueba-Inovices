              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Autentica al usuario OPERADOR y guarda el token en la variable de colección `tokenOperador`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuarioOperador}}\",\n  \"password\": \"{{claveOperador}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
