      "name": "02 Consulta de facturas",
      "description": "Listado, detalle, recurso inexistente y acceso sin token.",
      "item": [
        {
          "name": "CP-A08 Listar facturas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se ejecuta solo en la primera iteración: las demás iteraciones del CSV",
                  "// recorren únicamente los casos de creación de facturas.",
                  "if (pm.info.iteration > 0) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const facturas = pm.response.json();",
                  "const esquemaFactura = {",
                  "    type: 'object',",
                  "    required: ['id', 'number', 'customerName', 'type', 'subtotal', 'iva', 'retencion', 'total', 'createdAt'],",
                  "    properties: {",
                  "        id: { type: 'integer' },",
                  "        number: { type: 'string', pattern: '^FAC-\\\\d{5}$' },",
                  "        customerName: { type: 'string', minLength: 1 },",
                  "        type: { enum: ['Nacional', 'Exportacion', 'Gubernamental'] },",
                  "        subtotal: { type: 'number', exclusiveMinimum: 0 },",
                  "        iva: { type: 'number', minimum: 0 },",
                  "        retencion: { type: 'number', minimum: 0 },",
                  "        total: { type: 'number' },",
                  "        customsCode: { type: ['string', 'null'] },",
                  "        createdAt: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('CP-A08 Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CP-A08 Devuelve las 7 facturas sembradas (o más)', () => {",
                  "    pm.expect(facturas).to.be.an('array').with.length.of.at.least(7);",
                  "});",
                  "pm.test('CP-A08 Cada factura cumple el esquema', () => {",
                  "    pm.response.to.have.jsonSchema({ type: 'array', items: esquemaFactura });",
                  "});",
                  "pm.test('CP-A08 Ordenadas de la más reciente a la más antigua', () => {",
                  "    const fechas = facturas.map(f => new Date(f.createdAt).getTime());",
                  "    pm.expect(fechas).to.eql([...fechas].sort((a, b) => b - a));",
                  "});",
                  "pm.test('CP-A08 Responde en menos de 1 segundo', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
